{
  "name": "turborepo-docs-ko-site",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "predev": "node ./scripts/build-site-assets.mjs && fumadocs-mdx",
    "build": "next build",
    "prebuild": "node ./scripts/build-site-assets.mjs && fumadocs-mdx",
    "preview": "python3 -m http.server 3000 --directory out",
    "typecheck": "tsc --noEmit",
    "validate:translation": "python3 scripts/validate_translation.py && python3 scripts/audit_translation.py",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "16.5.1",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.5.1",
    "lucide-react": "^0.555.0",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
